{
  "seed": 31415,
  "device": "directml",
  "steps": 100,
  "warmup_steps": 10,
  "batch_size": 8,
  "learning_rate": 0.001,
  "eval_batches": 1,
  "eval_length_scales": [1, 2, 4],
  "cpu_threads": 6,
  "deterministic": false,
  "tasks": ["repeat_symbol", "variable_binding"],
  "data": {
    "vocab_size": 48,
    "repeat_length": 6,
    "binding_pairs": 4
  },
  "model": {
    "embedding_dim": 256,
    "heads": 8,
    "layers": 6,
    "feedforward_dim": 1024,
    "dropout": 0.0
  }
}
